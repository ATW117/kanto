class ProtocolBattle:
    def __init__(
        self,
        p1_team: str,
        p2_team: str,
        seed: int | str | None = None,
        names: tuple[str, str] = ("p1", "p2"),
        format: str = "gen1ou",
        validate: bool = True,
        timestamp: int = 0,
    ) -> None: ...
    def start(self) -> dict[str, Any]: ...
    def step(self, c1: str, c2: str) -> dict[str, Any]: ...
    def step_actions(self, a1: int, a2: int) -> dict[str, Any]: ...
    def observe(self, player: int) -> tuple[np.ndarray, np.ndarray]: ...
    def opp_team_targets(self, player: int) -> tuple[np.ndarray, np.ndarray]: ...
    def action_to_choice(self, player: int, action: int) -> str: ...
    def choice_to_action(self, player: int, choice: str) -> int: ...
    def legal_choices(self, player: int) -> list[str]: ...
    def request(self, player: int) -> Optional[str]: ...
    def input_log(self) -> list[str]: ...
    def view_log(self, channel: int = 0) -> list[str]: ...
    def packed_team(self, player: int) -> str: ...
    def copy(self) -> "ProtocolBattle": ...
    def set_timestamp(self, t: int) -> None: ...
    @property
    def seed(self) -> str: ...
    @property
    def log(self) -> list[str]: ...
    @property
    def outcome(self) -> int: ...
    @property
    def ended(self) -> bool: ...
    @property
    def started(self) -> bool: ...
    @property
    def turn(self) -> int: ...

class ProtocolTeams:
